# Shared local-development values. Copy to .env if you run services outside Docker Compose.
# Dummy values only: never put real credentials here.

# Kafka (group-wide connection variables)
KAFKA_BROKERS=localhost:29092
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=plain

# AWS SDK against local emulators
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000

# Postgres (incident-management)
DATABASE_URL=postgres://incidents:incidents@localhost:5432/incidents
DATABASE_SSL=false

# Service URLs
EVENT_STORE_URL=http://localhost:8081
INCIDENT_GRPC_ADDR=localhost:50051
