# correlation-engine local values (dummy values only, never real credentials)
PORT=8083
LOG_LEVEL=info

# Kafka (group-wide connection variables)
KAFKA_BROKERS=localhost:29092
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=plain
KAFKA_GROUP_ID=correlation-engine-cg
ALERT_TOPIC=security-alerts

# Downstream services
INCIDENT_GRPC_ADDR=localhost:50051
EVENT_STORE_URL=http://localhost:8081

# Correlation tuning
CORRELATION_WINDOW_MS=900000
ESCALATE_ALERT_COUNT=3
ENRICH_TIMEOUT_MS=2000
GRPC_DEADLINE_MS=15000

# Optional: override the incident.proto location (defaults to <repo>/proto/incident/v1/incident.proto)
# PROTO_PATH=
