{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.v1.json",
  "definitions": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "timestampOrNull": {
      "anyOf": [
        { "$ref": "#/definitions/timestamp" },
        { "type": "null" }
      ]
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "stringOrNull": {
      "type": ["string", "null"]
    },
    "integerOrNull": {
      "type": ["integer", "null"]
    },
    "service": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "logSource": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "host": { "$ref": "#/definitions/stringOrNull" },
        "region": { "$ref": "#/definitions/stringOrNull" },
        "accountId": { "$ref": "#/definitions/stringOrNull" }
      }
    }
  }
}
