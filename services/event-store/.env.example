# event-store local development values (dummy credentials only).
PORT=8081
LOG_LEVEL=info

# Kafka (group-wide connection variables)
KAFKA_BROKERS=localhost:29092
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=plain
KAFKA_GROUP_ID=event-store-cg
RAW_TOPIC=raw-events
NORMALIZED_TOPIC=normalized-events

# AWS SDK. Leave DYNAMODB_ENDPOINT and S3_ENDPOINT unset in AWS.
# Inside Docker Compose use http://dynamodb-local:8000 and http://s3mock:9090.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:9000
RAW_BUCKET=cs-raw-events
TABLE_PREFIX=cs-

# 3PC participant
TPC_TIMEOUT_MS=10000
# TPC_FORCE_VOTE=no   # demo: make this participant vote no on every canCommit
# The 3PC coordinator (incident-management) is asked for its decision before a
# timed-out transaction is resolved locally. Inside Docker Compose use
# http://incident-management:8082. Empty disables the lookup (timeout rule only).
COORDINATOR_URL=http://localhost:8082
COORDINATOR_TIMEOUT_MS=2000
