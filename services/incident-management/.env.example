# incident-management local values (run on the host against docker compose infra).
# Inside Docker Compose use postgres:5432, kafka:9092 and http://event-store:8081.
PORT=8082
GRPC_PORT=50051
LOG_LEVEL=info

# Postgres. In AWS leave DATABASE_URL unset and provide PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD
# from the RDS master secret, with DATABASE_SSL=true (the image ships the RDS CA bundle).
DATABASE_URL=postgres://incidents:incidents@localhost:5432/incidents
DATABASE_SSL=false
DATABASE_SSL_CA=/etc/ssl/rds/global-bundle.pem

EVENT_STORE_URL=http://localhost:8081
INCIDENT_TOPIC=incident-updates
CORRELATION_WINDOW_MS=900000

# 3PC: coordinator per-phase timeout, local participant timeout, and the demo fault hook.
TPC_TIMEOUT_MS=3000
TPC_PARTICIPANT_TIMEOUT_MS=10000
TPC_RECOVERY_INTERVAL_MS=15000
# TPC_FAULT=crash-after-precommit

KAFKA_BROKERS=localhost:29092
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=plain
